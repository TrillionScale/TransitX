# TransitX testnet 데모 환경 변수 — `npm run setup:all` 이 .env(이 파일 아님)에 자동 기입한다.
# 이 파일은 형태만 보여주는 예시. 실제 값은 .env (gitignore됨)에.
# ⚠ 모든 시드는 XRPL TESTNET 전용. 메인넷 시드를 절대 넣지 말 것.

# XRPL 서버 (생략 시 testnet altnet)
XRPL_SERVER=wss://s.altnet.rippletest.net:51233

# 01-create-issuers
USD_ISSUER_ADDR=
USD_ISSUER_SEED=
KRW_ISSUER_ADDR=
KRW_ISSUER_SEED=

# 03-create-user  (모바일 앱이 @env로 DEMO_SEED 를 읽어 Wallet.fromSeed)
DEMO_ADDR=
DEMO_SEED=

# 04-issue-liquidity
LP_ADDR=
LP_SEED=

# (선택) 머천트(Transit 단말기) 주소. 없으면 06-verify 는 LP_ADDR 를 사용.
MERCHANT_ADDR=
